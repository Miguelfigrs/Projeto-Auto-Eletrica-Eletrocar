# ==============================================================================
# Auto Elétrica Eletrocar - Variáveis de Ambiente de Exemplo (.env.example)
# Copie este arquivo para .env e preencha com seus valores locais/produção
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações Gerais da Aplicação
# ------------------------------------------------------------------------------
PROJECT_NAME="Auto Elétrica Eletrocar - API"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
API_PORT=8000

# ------------------------------------------------------------------------------
# 2. Banco de Dados PostgreSQL 16 (Docker & Produção)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=eletrocar2026
POSTGRES_DB=eletrocar_db
POSTGRES_PORT=5432

# URL de Conexão com o Banco:
# - Docker Compose: injeta internamente postgresql+asyncpg://postgres:eletrocar2026@postgres:5432/eletrocar_db
# - Desenvolvimento local com Postgres:
DATABASE_URL="postgresql+asyncpg://postgres:eletrocar2026@localhost:5432/eletrocar_db"

# Alternativa offline (SQLite assíncrono):
# DATABASE_URL="sqlite+aiosqlite:///../Eletrocar.Database/data/eletrocar.db"

# ------------------------------------------------------------------------------
# 3. Gerenciador Web do Banco de Dados (pgAdmin 4)
# ------------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@eletrocar.com.br
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# ------------------------------------------------------------------------------
# 4. Segurança e Autenticação JWT
# ------------------------------------------------------------------------------
SECRET_KEY="eletrocar_secret_key_super_segura_2026_auto_eletrica"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------------------------------------------------------------------------------
# 5. Integração Telegram Voice Bot (Abertura de OS por Voz)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="SEU_TOKEN_TELEGRAM_BOT_AQUI"
TELEGRAM_WEBHOOK_SECRET="eletrocar_webhook_secret_2026"
