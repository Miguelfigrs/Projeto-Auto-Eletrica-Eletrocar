# ==============================================================================
# Auto Elétrica Eletrocar - Variáveis de Ambiente de Exemplo (.env.example)
# Copie para .env (usado pelo docker compose) e ajuste os valores.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Aplicação
# ------------------------------------------------------------------------------
PROJECT_NAME="Auto Elétrica Eletrocar - API"
API_V1_PREFIX="/api/v1"
API_PORT=8000
# desenvolvimento | producao  (em produção a API recusa segredos padrão, CORS "*" e carga de demonstração)
AMBIENTE=desenvolvimento
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
URL_PAINEL="http://localhost:5173"

# ------------------------------------------------------------------------------
# 2. PostgreSQL 16 (esquema criado pelas migrações Alembic da API)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=eletrocar2026
POSTGRES_DB=eletrocar_db
POSTGRES_PORT=5432
# Carga de demonstração (Eletrocar.Database/seed_completo.sql) aplicada quando o banco não tem usuários
SEED_DADOS_DEMO=true
# Administrador inicial (opcional) criado se o banco estiver vazio e sem carga de demonstração
ADMIN_EMAIL=
ADMIN_SENHA_INICIAL=

# ------------------------------------------------------------------------------
# 3. pgAdmin 4
# ------------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@eletrocar.com.br
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# ------------------------------------------------------------------------------
# 4. Segurança (JWT access curto + refresh rotativo em cookie HTTP-Only)
# ------------------------------------------------------------------------------
SECRET_KEY="troque-por-uma-chave-aleatoria-com-mais-de-32-caracteres"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Desconto máximo (%) que o balconista concede sem PIN do gestor
LIMITE_DESCONTO_SEM_AUTORIZACAO_PERCENTUAL=5

# ------------------------------------------------------------------------------
# 5. Telegram Voice Bot -> Whisper ASR -> LLM (Claude)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Enviado pelo Telegram no header X-Telegram-Bot-Api-Secret-Token (configure no setWebhook)
TELEGRAM_WEBHOOK_SECRET="troque-este-segredo"
WHISPER_API_URL="https://api.openai.com/v1/audio/transcriptions"
WHISPER_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODELO=claude-opus-5-5

# ------------------------------------------------------------------------------
# 6. PIX (BR Code com chave do recebedor) e webhook de liquidação do PSP
# ------------------------------------------------------------------------------
PIX_CHAVE=
PIX_WEBHOOK_SECRET="troque-este-segredo"
